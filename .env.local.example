# Copy this file to .env.local and adjust values for your environment.

# Master switch for search-engine indexing. Keep "false" until the site is
# ready for public traffic — flips noindex meta tags, robots.txt, the
# X-Robots-Tag header, and the sitemap all at once.
NEXT_PUBLIC_ALLOW_INDEXING=false

# Canonical site origin, no trailing slash. Used to build canonical URLs,
# Open Graph URLs, and JSON-LD schema.
NEXT_PUBLIC_SITE_URL=https://devplaneco.com

# Supabase project credentials. URL and publishable key are safe to expose
# to the browser (NEXT_PUBLIC_). Get these from Supabase → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Secret key — bypasses Row Level Security. Server-only, never NEXT_PUBLIC_,
# never imported into client components.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx
